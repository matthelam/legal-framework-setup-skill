{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_PYTHON}}",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/memory_hook.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_PYTHON}}",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/memory_hook.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_PYTHON}}",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/memory_hook.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_PYTHON}}",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/memory_hook.py"
            ]
          }
        ]
      }
    ]
  }
}
